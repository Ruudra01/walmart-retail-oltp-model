# Copy to .env and fill in. .env is gitignored and must stay that way.
# Real credentials never go in this file.

# Read by the Postgres container (docker/compose.yml)
POSTGRES_DB=retail_oltp
POSTGRES_USER=CHANGEME
POSTGRES_PASSWORD=CHANGEME

# Read by psql, pg_prove, and the generator
PGHOST=localhost
PGPORT=5432
PGDATABASE=retail_oltp
PGUSER=CHANGEME
PGPASSWORD=CHANGEME
