# Generated data is never committed — only the code that generates it.
data/
*.parquet
*.duckdb
*.dump
*.sql.gz

# Secrets
.env

# Tool output
schemaspy/output/

# Python
__pycache__/
.venv/

# Node (docs/erd/generate.js's dependencies). package-lock.json is committed
# on purpose, for reproducible renders - see docs/erd/README.md.
node_modules/

# macOS
.DS_Store

# Committed on purpose. seeds/ is reference data that is part of the model, and
# docs/erd/ is the rendered diagram for people without DBML tooling. Listed
# explicitly so a future data/ or image rule cannot quietly swallow them.
!seeds/
!docs/erd/

# ...except the intermediate SVG docs/erd/generate.js writes on its way to
# erd.png - a build byproduct, not the rendered diagram itself.
docs/erd/erd.svg
